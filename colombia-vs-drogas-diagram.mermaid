flowchart TD
    subgraph "Pre-Processing & Data Loading"
        A[Load Preprocessed Data] --> |Contains| B[Processed Operations Data]
        A --> |Contains| C[Municipality Lists]
        A --> |Contains| D[Temporal Aggregations]
        A --> |Contains| E[Top Municipalities]
    end

    subgraph "UI Components"
        F[Main UI FluidPage] --> G[Title Container]
        F --> H[Sidebar Panel]
        F --> I[Main Panel]
        
        H --> J[Dataset Selector]
        H --> K[Dataset Description]
        H --> L[Map Configuration Controls]
        H --> M[Loading Status Indicator]
        
        I --> N[Tab Panel]
        
        N --> O[Tab 1: Heat Map]
        N --> P[Tab 2: Temporal Distribution]
        
        O --> Q[Interactive Map]
        O --> R[Timeline Chart]
        
        P --> S[Time Heatmap]
        P --> T[Municipality Search]
        P --> U[Selected Timeline]
        P --> V[Municipality Bar Chart]
    end
    
    subgraph "Server Logic"
        W[Reactive Values] --> X[Selected Data]
        X --> Y[Map Data]
        X --> Z[Heatmap Data]
        
        AA[Map Rendering] --> AB[Heatmap Layer]
        AA --> AC[Cluster Observer]
        
        AD[Timeline Rendering]
        AE[Heatmap Rendering]
        
        AF[Municipality Filtering] --> AG[Filtered Heatmap]
        AF --> AH[Selected Timeline Rendering]
        AF --> AI[Bar Chart Rendering]
    end
    
    B --> X
    D --> AD
    D --> Z
    Y --> AA
    Z --> AE
    AG --> AE
    AG --> AH
    AG --> AI
